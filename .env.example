# Copier en `.env` à la racine et remplir. NE JAMAIS committer `.env`.
# Les commandes --help et la suite de tests tournent sans aucune clé.
# Ces clés sont celles du SERVEUR : chaque compte peut aussi saisir les siennes dans
# l'interface (Réglages > Clés d'API), qui l'emportent pour lui.

# --- Génération CV / lettres (Mistral) ---
MISTRAL_API_KEY=

# --- Sources d'offres ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Mode multi-comptes (optionnel) ---
# Tant que ces variables sont absentes, le mode mono-poste (SQLite local) reste actif.
# DATABASE_URL=postgresql+psycopg://…
# SUPABASE_URL=https://<projet>.supabase.co
# SUPABASE_JWKS_URL=https://<projet>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# --- Chiffrement des clés d'API saisies dans l'interface ---
# Obligatoire en multi-comptes. En mono-poste, généré au besoin dans data/.secret_key.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JOBTOOL_SECRET_KEY=
